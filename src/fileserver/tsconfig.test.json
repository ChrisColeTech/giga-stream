{
  // The tests live outside the source folder, so this one type-checks them and emits nothing
  // (`npm run typecheck` runs both projects). No `rootDir`: the source imports `src/shared/media`
  // by relative `.ts` paths, which are outside any fileserver root.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
