# The fileserver's local environment (docs/03 section 1). Copied to `.env` and
# adjusted per machine; `.env` is gitignored and never committed.
# Loaded by `npm run dev:gateway` (.env only) and `npm start` (.env, then
# production.env, whose values win). A real environment variable wins over both.

# Development and production never share a port: dev is 8090, production 8190.
# PORT=8090

# The folder this fileserver keeps its own database and caches in.
# DATA_DIR=

# The admin backend's address before Settings names another; an empty value
# leaves the mode default (http://127.0.0.1:8091 in development, :8191 in
# production). Set it when the backend runs somewhere else.
# ADMIN_PROXY_TARGET=

# A LAN or cloud admin backend must use https; the development override.
# ALLOW_INSECURE_ADMIN=true
