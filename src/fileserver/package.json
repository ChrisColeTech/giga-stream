{
  "name": "giga-stream-fileserver",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "main": "dist/app/main.js",
  "description": "The Giga Stream fileserver and Electron host. It owns local device data, reads the admin Turso database directly, requests providers only, and serves the interface same-origin.",
  "scripts": {
    "build": "node src/build-shared.ts && tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/store/migrations','dist/store/migrations',{recursive:true})\"",
    "dev": "npm run build && electron .",
    "dev:gateway": "node src/build-shared.ts && tsx --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=production.env dist/server.js",
    "start:app": "electron .",
    "typecheck": "node src/build-shared.ts && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node src/build-shared.ts && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.6.4",
    "@fastify/static": "^8.3.0",
    "@ghostery/adblocker-electron": "^2.18.1",
    "@libsql/client": "^0.18.0",
    "fastify": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^42.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
