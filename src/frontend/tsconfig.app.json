{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path alias */
    "paths": {
      "@/*": ["./src/*"],
      "@giga/ui/*": ["../shared/ui/src/*"],
      "@giga/http/*": ["../shared/http/src/*"],
      "@giga/watch/*": ["../shared/watch/src/*"]
    }
  },
  /* The family library, the request layer and the shared watch semantics are part of this program: their files take
     this JSX and path setup, and the test runner (tsx) applies a tsconfig's options only to the files its include
     matches (docs/27 section 3). */
  "include": ["src", "../shared/ui/src", "../shared/http/src", "../shared/watch/src"]
}
