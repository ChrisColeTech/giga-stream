{
  // Type-check only: Node runs these files as they are (type stripping), like the shared media library it
  // imports, so nothing is emitted. `erasableSyntaxOnly` refuses what Node cannot strip.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    // The real-file tests make the fixtures with scripts/fixtures/make-fixtures.mjs.
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
