# The development setup (docs/26 sections 3.6 and 3.7): the four seeded live test channels, served by the backend
# itself from the fixture files (npm run fixtures), and the manual player page at /test/player.html.
# Loaded before .env, so a value in your own .env wins. Secrets (JWT_SECRET, the bootstrap admin) stay in .env.
SEED_TEST_CHANNELS=true
TEST_PAGE=true
