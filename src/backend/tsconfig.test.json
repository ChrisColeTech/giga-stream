{
  // The tests live outside `rootDir: src`, so the build config cannot include them without changing
  // where dist/ lands. This one type-checks them and emits nothing; `npm run typecheck` runs both.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "test", "scripts/import-live-server-db.ts"]
}
